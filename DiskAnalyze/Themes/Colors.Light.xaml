<!--
    Light theme colour tokens, palette "Graphite · Cobalt" (DEVELOPMENT.md D-029).
    Colors.Dark.xaml must define exactly the same keys. ThemeManager swaps the whole dictionary,
    so everything that uses a token through DynamicResource repaints at once.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces and lines -->
    <Color x:Key="Color.Window">#F3F4F6</Color>        <!-- window and diagram background -->
    <Color x:Key="Color.Chrome">#FFFFFF</Color>        <!-- title bar, toolbar, status bar -->
    <Color x:Key="Color.Surface">#FFFFFF</Color>       <!-- panels, tooltips, inputs, menus -->
    <Color x:Key="Color.Band">#F0F2F5</Color>          <!-- alternate row groups -->
    <Color x:Key="Color.Hover">#E7EAEF</Color>
    <Color x:Key="Color.Selected">#DFE7FB</Color>
    <Color x:Key="Color.Line">#D7DBE1</Color>          <!-- 1 px separators -->
    <Color x:Key="Color.LineStrong">#A9B0BA</Color>    <!-- control borders, window border -->
    <Color x:Key="Color.Scrim">#E6F3F4F6</Color>       <!-- loading overlay over content -->

    <!-- Text -->
    <Color x:Key="Color.Text">#14171C</Color>
    <Color x:Key="Color.TextSecondary">#4A515C</Color>
    <Color x:Key="Color.TextMuted">#6B7380</Color>

    <!-- Accent -->
    <Color x:Key="Color.Accent">#2453D4</Color>
    <Color x:Key="Color.AccentHover">#1D44B0</Color>
    <Color x:Key="Color.AccentPressed">#173893</Color>
    <Color x:Key="Color.OnAccent">#FFFFFF</Color>

    <!-- Status: reserved meanings, always paired with text -->
    <Color x:Key="Color.Warning">#FAB219</Color>
    <Color x:Key="Color.Critical">#D03B3B</Color>

    <!-- Diagram series in fixed order (validated: adjacent CVD ΔE ≥ 9.1, normal-vision ΔE ≥ 19.6) -->
    <Color x:Key="Color.Series0">#2A78D6</Color>
    <Color x:Key="Color.Series1">#EB6834</Color>
    <Color x:Key="Color.Series2">#1BAF7A</Color>
    <Color x:Key="Color.Series3">#EDA100</Color>
    <Color x:Key="Color.Series4">#E87BA4</Color>
    <Color x:Key="Color.Series5">#008300</Color>
    <Color x:Key="Color.Series6">#6250D6</Color>
    <Color x:Key="Color.Series7">#E34948</Color>
    <Color x:Key="Color.Other">#A3A8B0</Color>

    <!-- Text drawn on a series fill -->
    <Color x:Key="Color.SeriesLabel0">#FFFFFF</Color>
    <Color x:Key="Color.SeriesLabel1">#FFFFFF</Color>
    <Color x:Key="Color.SeriesLabel2">#FFFFFF</Color>
    <Color x:Key="Color.SeriesLabel3">#0B0B0B</Color>
    <Color x:Key="Color.SeriesLabel4">#FFFFFF</Color>
    <Color x:Key="Color.SeriesLabel5">#FFFFFF</Color>
    <Color x:Key="Color.SeriesLabel6">#FFFFFF</Color>
    <Color x:Key="Color.SeriesLabel7">#FFFFFF</Color>
    <Color x:Key="Color.OtherLabel">#14171C</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Chrome" Color="{StaticResource Color.Chrome}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Band" Color="{StaticResource Color.Band}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}" />
    <SolidColorBrush x:Key="Brush.Selected" Color="{StaticResource Color.Selected}" />
    <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="Brush.LineStrong" Color="{StaticResource Color.LineStrong}" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="{StaticResource Color.Scrim}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Critical" Color="{StaticResource Color.Critical}" />
    <SolidColorBrush x:Key="Brush.Other" Color="{StaticResource Color.Other}" />
</ResourceDictionary>
