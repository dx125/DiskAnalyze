<UserControl x:Class="DiskAnalyze.Views.DuplicatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:DiskAnalyze.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:InvertibleBooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:FileSizeConverter x:Key="FileSizeConverter" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Folder A picker -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Folder A:" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding LeftFolderPath, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Padding="4,2" />
            <Button Grid.Column="2" Content="Browse..." Margin="6,0,0,0" Padding="10,2"
                    Command="{Binding BrowseLeftCommand}" />
        </Grid>

        <!-- Folder B picker -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Folder B:" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding RightFolderPath, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Padding="4,2" />
            <Button Grid.Column="2" Content="Browse..." Margin="6,0,0,0" Padding="10,2"
                    Command="{Binding BrowseRightCommand}" />
        </Grid>

        <!-- Actions / status -->
        <Grid Grid.Row="2" Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Find Duplicates" Padding="14,4"
                    Command="{Binding FindDuplicatesCommand}" />
            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0" />
            <ProgressBar Grid.Column="2" IsIndeterminate="True" Width="120" Height="14"
                         Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <!-- Side-by-side results -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Matches}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="All"
                  CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Folder A File" Width="*"
                                    Binding="{Binding LeftName}" />
                <DataGridTextColumn Header="Folder B File" Width="*"
                                    Binding="{Binding RightName}" />
                <DataGridTextColumn Header="Size" Width="Auto"
                                    Binding="{Binding Size, Converter={StaticResource FileSizeConverter}}" />
                <DataGridTextColumn Header="Ext" Width="Auto"
                                    Binding="{Binding Extension}" />
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <MultiBinding StringFormat="A: {0}&#x0a;B: {1}">
                                <Binding Path="LeftFullPath" />
                                <Binding Path="RightFullPath" />
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </Grid>
</UserControl>
