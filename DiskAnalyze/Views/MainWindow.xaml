<Window x:Class="DiskAnalyze.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiskAnalyze"
        xmlns:views="clr-namespace:DiskAnalyze.Views"
        xmlns:viewModels="clr-namespace:DiskAnalyze.ViewModels"
        xmlns:converters="clr-namespace:DiskAnalyze.Converters"
        mc:Ignorable="d"
        Title="File System Analyzer" Height="600" Width="800">

    <Window.Resources>
        <converters:InvertibleBooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Data Template for CircularDiagramViewModel -->
        <DataTemplate DataType="{x:Type viewModels:CircularDiagramViewModel}">
            <views:CircularDiagramView />
        </DataTemplate>

        <!-- Data Template for ChartDiagramViewModel -->
        <DataTemplate DataType="{x:Type viewModels:ChartDiagramViewModel}">
            <views:ChartDiagramView />
        </DataTemplate>

        <!-- Data Template for DuplicatesViewModel -->
        <DataTemplate DataType="{x:Type viewModels:DuplicatesViewModel}">
            <views:DuplicatesView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Menu -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button Content="Circular Diagram" Margin="5" Padding="10,5" Command="{Binding ShowCircularDiagramCommand}" />
            <Button Content="Chart Diagram" Margin="5" Padding="10,5" Command="{Binding ShowChartDiagramCommand}" />
            <Button Content="Find Duplicates" Margin="5" Padding="10,5" Command="{Binding ShowDuplicatesCommand}" />
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <!-- Loading Overlay -->
            <Grid Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Rectangle Fill="#80000000" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Loading..." FontSize="24" Foreground="White" HorizontalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Width="200" Height="20" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>

            <!-- Content Area -->
            <ContentControl Content="{Binding CurrentViewModel}"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <TextBlock Text="{Binding StatusMessage}" />
        </StatusBar>
    </Grid>
</Window>