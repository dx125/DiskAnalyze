<UserControl x:Class="DiskAnalyze.Views.SegmentContentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:DiskAnalyze.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="240">

    <Border BorderBrush="#DDD" BorderThickness="1,0,0,0"
            Visibility="{Binding HasContents, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="✕" VerticalAlignment="Top" Padding="6,0"
                        Background="Transparent" BorderThickness="0" ToolTip="Close"
                        Command="{Binding HideContentsCommand}" />
                <TextBlock Text="{Binding ContentsTitle}" FontWeight="Bold" TextWrapping="Wrap" />
            </DockPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding SegmentContents}"
                     BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:FileSystemEntityViewModel}">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{Binding FullPath}" />
                                    <TextBlock Text="{Binding ModifiedInfo}" Foreground="#555" />
                                </StackPanel>
                            </Grid.ToolTip>

                            <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SizeText" Grid.Column="1" Margin="8,0,0,0" Foreground="#555"
                                       Text="{Binding Size, Converter={StaticResource FileSizeConverter}}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <!-- Online-only files take no local space; say so instead of showing "0 B" -->
                            <DataTrigger Binding="{Binding IsCloudOnly}" Value="True">
                                <Setter TargetName="SizeText" Property="Text" Value="cloud only" />
                                <Setter TargetName="SizeText" Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
