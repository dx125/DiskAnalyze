<UserControl x:Class="DiskAnalyze.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Section heading: uppercase label over a 1 px rule -->
        <Style x:Key="Settings.Section" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,6" />
            <Setter Property="Margin" Value="0,28,0,14" />
        </Style>

        <Style x:Key="Settings.Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Settings.Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="24,16,24,24" MaxWidth="680" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Button.Icon}" Command="{Binding BackCommand}"
                        ToolTip="Back (Esc)" AutomationProperties.Name="Back">
                    <Path Data="{StaticResource Icon.ChevronLeft}" Style="{StaticResource Icon.Stroke}" />
                </Button>
                <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Appearance -->
            <Border Style="{StaticResource Settings.Section}">
                <TextBlock Text="APPEARANCE" Style="{StaticResource Text.SectionLabel}" />
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Theme" Style="{StaticResource Settings.Label}" VerticalAlignment="Top" Margin="0,5,0,0" />
                <StackPanel Grid.Column="1">
                    <!-- Items overlap by 1 px so neighbours share a border; the margin keeps the first one inside -->
                    <StackPanel Orientation="Horizontal" Margin="1,0,0,0">
                        <RadioButton Content="System" GroupName="Theme" Style="{StaticResource Segmented.Item}"
                                     IsChecked="{Binding Theme, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=System}" />
                        <RadioButton Content="Light" GroupName="Theme" Style="{StaticResource Segmented.Item}"
                                     IsChecked="{Binding Theme, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Light}" />
                        <RadioButton Content="Dark" GroupName="Theme" Style="{StaticResource Segmented.Item}"
                                     IsChecked="{Binding Theme, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Dark}" />
                    </StackPanel>
                    <TextBlock Text="System follows the Windows app mode and switches along with it."
                               Style="{StaticResource Settings.Hint}" />
                </StackPanel>
            </Grid>

            <!-- Scanning -->
            <Border Style="{StaticResource Settings.Section}">
                <TextBlock Text="SCANNING" Style="{StaticResource Text.SectionLabel}" />
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Scan on startup" Style="{StaticResource Settings.Label}" />
                <CheckBox Grid.Column="1" Content="Scan as soon as DiskAnalyze opens" IsChecked="{Binding ScanOnStartup}" />

                <TextBlock Grid.Row="2" Text="What to scan" Style="{StaticResource Settings.Label}" VerticalAlignment="Top" Margin="0,5,0,0" />
                <StackPanel Grid.Row="2" Grid.Column="1">
                    <ComboBox Width="280" HorizontalAlignment="Left" ItemsSource="{Binding ScanTargets}"
                              DisplayMemberPath="DisplayName" SelectedItem="{Binding StartupTarget}"
                              IsEnabled="{Binding ScanOnStartup}" />
                    <TextBlock Text="Also selected in the toolbar at startup. Folders opened with Folder… are listed too."
                               Style="{StaticResource Settings.Hint}" />
                </StackPanel>
            </Grid>

            <!-- Display -->
            <Border Style="{StaticResource Settings.Section}">
                <TextBlock Text="DISPLAY" Style="{StaticResource Text.SectionLabel}" />
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Pie slices" Style="{StaticResource Settings.Label}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding DecreasePieSlicesCommand}"
                            ToolTip="Fewer slices" AutomationProperties.Name="Fewer slices">
                        <Path Data="{StaticResource Icon.Minus}" Style="{StaticResource Icon.Stroke}" />
                    </Button>
                    <Border Width="40" Height="26" Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.LineStrong}" BorderThickness="0,1">
                        <TextBlock Text="{Binding PieSlices}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                    </Border>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding IncreasePieSlicesCommand}"
                            ToolTip="More slices" AutomationProperties.Name="More slices">
                        <Path Data="{StaticResource Icon.Plus}" Style="{StaticResource Icon.Stroke}" />
                    </Button>
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Secondary}">
                        <Run Text="largest items; the rest are grouped as “Other” (" /><Run Text="{Binding MinPieSlices, Mode=OneWay}" /><Run Text="–" /><Run Text="{Binding MaxPieSlices, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- Photo analysis: the user-settings layer of the capability gate (DEVELOPMENT.md §6.3) -->
            <Border Style="{StaticResource Settings.Section}">
                <TextBlock Text="PHOTO ANALYSIS" Style="{StaticResource Text.SectionLabel}" />
            </Border>
            <TextBlock Text="Not available yet. These switches take effect when the photo browser ships (roadmap, Feature B)."
                       Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <Grid IsEnabled="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Content analysis" Style="{StaticResource Settings.Label}" />
                <ComboBox Grid.Column="1" Width="160" HorizontalAlignment="Left"
                          ItemsSource="{Binding PhotoContentAnalysisOptions}" SelectedItem="{Binding PhotoContentAnalysis, Mode=OneWay}" />

                <TextBlock Grid.Row="2" Text="CLIP on ONNX Runtime" Style="{StaticResource Settings.Label}" />
                <ComboBox Grid.Row="2" Grid.Column="1" Width="160" HorizontalAlignment="Left"
                          ItemsSource="{Binding ClipOnnxOptions}" SelectedItem="{Binding ClipOnnx, Mode=OneWay}" />

                <TextBlock Grid.Row="4" Text="Execution provider" Style="{StaticResource Settings.Label}" />
                <ComboBox Grid.Row="4" Grid.Column="1" Width="160" HorizontalAlignment="Left"
                          ItemsSource="{Binding ExecutionProviderOptions}" SelectedItem="{Binding ExecutionProvider, Mode=OneWay}" />
            </Grid>

            <!-- Where it goes -->
            <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Margin="0,32,0,0" Padding="0,10,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap">
                        <Run Text="Changes apply immediately and are saved to" />
                        <Run Text="{Binding SettingsFilePath, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding SaveError}" Foreground="{DynamicResource Brush.Critical}" TextWrapping="Wrap" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SaveError}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
