<UserControl x:Class="DiskAnalyze.Views.ChartDiagramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DiskAnalyze.Views"
             xmlns:converters="clr-namespace:DiskAnalyze.Converters"
             xmlns:viewModels="clr-namespace:DiskAnalyze.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:InvertibleBooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:ScaleMagnifierConverter x:Key="ScaleMagnifierConverter" />
        <converters:FileSystemEntityToBrushConverter x:Key="FileSystemEntityToBrushConverter" />
        <converters:FileSizeConverter x:Key="FileSizeConverter" />
        <converters:PercentToWidthConverter x:Key="PercentToWidthConverter" />
        <!-- Positions the directory arrow just inside the right end of the bar -->
        <converters:PercentToWidthConverter x:Key="PercentToTranslateConverter" Offset="-14" />
        <converters:BooleanToGridLengthConverter x:Key="BooleanToGridLengthConverter" />

        <Style x:Key="ChartBarStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="25" />
            <Setter Property="RadiusX" Value="3" />
            <Setter Property="RadiusY" Value="3" />
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>

        <Style x:Key="ChartTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="5,0,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{Binding HasContents, Converter={StaticResource BooleanToGridLengthConverter}, ConverterParameter=220}" />
        </Grid.ColumnDefinitions>

        <!-- Navigation Controls -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button Content="↑ Up" Width="60" Margin="0,0,10,0"
                    Command="{Binding NavigateUpCommand}"
                    Visibility="{Binding CanNavigateUp, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Text="{Binding CurrentPath}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Chart Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
            <ItemsControl ItemsSource="{Binding DisplayedEntities}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:FileSystemEntityViewModel}">
                        <Grid Margin="0,5">
                            <Grid.RenderTransform>
                                <ScaleTransform
                                    ScaleX="{Binding IsDirectory, Converter={StaticResource ScaleMagnifierConverter}, ConverterParameter=1.02}"
                                    ScaleY="{Binding IsDirectory, Converter={StaticResource ScaleMagnifierConverter}, ConverterParameter=1.02}"
                                    CenterX="0" CenterY="12.5" />
                            </Grid.RenderTransform>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Rectangle Style="{StaticResource ChartBarStyle}"
                                           Fill="{Binding Converter={StaticResource FileSystemEntityToBrushConverter}}"
                                           Width="{Binding PercentageOfTotal, Converter={StaticResource PercentToWidthConverter}}"
                                           HorizontalAlignment="Left"
                                           Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Rectangle.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.NavigateToDirectoryCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}" />
                                    </Rectangle.InputBindings>
                                    <Rectangle.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Show contents"
                                                      Command="{Binding PlacementTarget.Tag.ShowContentsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Show in Explorer"
                                                      Command="{Binding PlacementTarget.Tag.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Visibility="{Binding PlacementTarget.DataContext.IsOtherCategory, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                                        </ContextMenu>
                                    </Rectangle.ContextMenu>
                                </Rectangle>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource ChartTextStyle}" />
                                    <TextBlock Text="{Binding UsageInfo}" Style="{StaticResource ChartTextStyle}" Foreground="#333"
                                               Visibility="{Binding IsDrive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Column="1" Text="{Binding Size, Converter={StaticResource FileSizeConverter}}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />

                            <!-- Clickable Indicator for Directories -->
                            <Path Grid.Column="0" Data="M0,0 L6,6 L0,12 Z" Fill="White"
                                  Visibility="{Binding IsDirectory, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path.RenderTransform>
                                    <TranslateTransform X="{Binding PercentageOfTotal, Converter={StaticResource PercentToTranslateConverter}}" Y="0" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Contents Side Panel -->
        <local:SegmentContentsView Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" />
    </Grid>
</UserControl>
