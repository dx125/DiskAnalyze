<UserControl x:Class="DiskAnalyze.Views.ChartDiagramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DiskAnalyze.Views"
             xmlns:viewModels="clr-namespace:DiskAnalyze.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="ChartTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="5,0,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{Binding HasContents, Converter={StaticResource BooleanToGridLengthConverter}, ConverterParameter=240}" />
        </Grid.ColumnDefinitions>

        <!-- Navigation Controls -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button Content="↑ Up" Width="60" Margin="0,0,10,0"
                    Command="{Binding NavigateUpCommand}"
                    Visibility="{Binding CanNavigateUp, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Text="{Binding CurrentPath}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Chart Area: virtualized, so folders with tens of thousands of entries stay responsive -->
        <ItemsControl Grid.Row="1" Margin="10" ItemsSource="{Binding DisplayedEntities}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer CanContentScroll="True" Focusable="False"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type viewModels:FileSystemEntityViewModel}">
                    <!-- The whole row is clickable and carries the context menu -->
                    <Border x:Name="Row" Background="Transparent" Padding="0,3" CornerRadius="3"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding DataContext.NavigateToDirectoryCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          CommandParameter="{Binding}" />
                        </Border.InputBindings>
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Show contents"
                                          Command="{Binding PlacementTarget.Tag.ShowContentsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Show in Explorer"
                                          Command="{Binding PlacementTarget.Tag.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Visibility="{Binding PlacementTarget.DataContext.IsOtherCategory, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                            </ContextMenu>
                        </Border.ContextMenu>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>

                            <!-- Bar track: the bar takes PercentageOfTotal of the available width -->
                            <Grid Grid.Column="0" Height="25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding PercentageOfTotal, Converter={StaticResource PercentToStarConverter}}" />
                                    <ColumnDefinition Width="{Binding PercentageOfTotal, Converter={StaticResource PercentToStarConverter}, ConverterParameter=Remainder}" />
                                </Grid.ColumnDefinitions>

                                <Rectangle Grid.Column="0" MinWidth="3" RadiusX="3" RadiusY="3" Stroke="White" StrokeThickness="1">
                                    <Rectangle.Fill>
                                        <MultiBinding Converter="{StaticResource EntityBrushConverter}">
                                            <Binding Path="ColorIndex" />
                                            <Binding Path="IsOtherCategory" />
                                        </MultiBinding>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource ChartTextStyle}" />
                                    <TextBlock Text="{Binding UsageInfo}" Style="{StaticResource ChartTextStyle}" Foreground="#333"
                                               Visibility="{Binding IsDrive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Column="1" Text="{Binding Size, Converter={StaticResource FileSizeConverter}}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />

                            <!-- Drill-down marker for directories, in its own column so it never covers the label -->
                            <Path Grid.Column="2" Data="M0,0 L5,5 L0,10" Stroke="#888" StrokeThickness="1.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="{Binding IsDirectory, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <DataTemplate.Triggers>
                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#14000000" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                            <Setter TargetName="Row" Property="Cursor" Value="Hand" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Contents Side Panel -->
        <local:SegmentContentsView Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" />
    </Grid>
</UserControl>
