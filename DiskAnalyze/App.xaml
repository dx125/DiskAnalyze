<Application x:Class="DiskAnalyze.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DiskAnalyze.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <!-- Converters shared by all views -->
        <converters:InvertibleBooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:BooleanToGridLengthConverter x:Key="BooleanToGridLengthConverter" />
        <converters:ScaleMagnifierConverter x:Key="ScaleMagnifierConverter" />
        <converters:EntityBrushConverter x:Key="EntityBrushConverter" />
        <converters:FileSizeConverter x:Key="FileSizeConverter" />
        <converters:PercentToStarConverter x:Key="PercentToStarConverter" />
        <converters:PercentThresholdToVisibilityConverter x:Key="PercentThresholdToVisibilityConverter" />
    </Application.Resources>
</Application>
